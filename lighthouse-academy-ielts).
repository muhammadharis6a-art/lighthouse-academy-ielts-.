            required: ['essayType', 'topic', 'prompt', 'instructions', 'minWords', 'sampleBand9Answer']
          }
        },
        required: ['title', 'examType', 'task1', 'task2']
      };
    } else {
      prompt = `Generate an authentic 3-part IELTS Speaking interview test.
Topic suggestion: ${topicHint || 'Architecture, personal technology, public spaces, travel, hobbies, or education'}.
Part 1: Topic with 5 warm-up questions.
Part 2: Cue Card topic with 4 bullet prompts, 1 min preparation, 2 min speaking.
Part 3: 5 abstract two-way discussion questions exploring social and philosophical dimensions.`;

      responseSchema = {
        type: Type.OBJECT,
        properties: {
          title: { type: Type.STRING },
          part1: {
            type: Type.OBJECT,
            properties: {
              topic: { type: Type.STRING },
              questions: { type: Type.ARRAY, items: { type: Type.STRING } }
            },
            required: ['topic', 'questions']
          },
          part2: {
            type: Type.OBJECT,
            properties: {
              cueCardTopic: { type: Type.STRING },
              bulletPoints: { type: Type.ARRAY, items: { type: Type.STRING } },
              prepTimeSeconds: { type: Type.INTEGER },
              speakingTimeSeconds: { type: Type.INTEGER }
            },
            required: ['cueCardTopic', 'bulletPoints', 'prepTimeSeconds', 'speakingTimeSeconds']
          },
          part3: {
            type: Type.OBJECT,
            properties: {
              topic: { type: Type.STRING },
              questions: { type: Type.ARRAY, items: { type: Type.STRING } }
            },
            required: ['topic', 'questions']
          }
        },
        required: ['title', 'part1', 'part2', 'part3']
      };
    }

    const response = await ai.models.generateContent({
      model: 'gemini-3.8-flash',
      contents: prompt,
      config: {
        responseMimeType: 'application/json',
        responseSchema: responseSchema,
      },
    });

    const parsedData = JSON.parse(response.text || '{}');
    return res.json({ success: true, test: parsedData, source: 'gemini' });
  } catch (error: any) {
    console.error('Error generating IELTS test:', error);
    return res.status(500).json({ error: 'Failed to generate test with AI', details: error.message });
  }
});

