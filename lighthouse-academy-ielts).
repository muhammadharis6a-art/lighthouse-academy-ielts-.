// 1. Unlimited Test Generator Endpoint
app.post('/api/generate-test', async (req, res) => {
  try {
    const { module, examType = 'academic', topicHint } = req.body;

    if (!module || !['reading', 'listening', 'writing', 'speaking'].includes(module)) {
      return res.status(400).json({ error: 'Valid module is required' });
    }

    if (!apiKey) {
      return res.status(200).json({
        success: true,
        source: 'fallback',
        message: 'Loaded from Lighthouse Academy test vault'
      });
    }

    let prompt = '';
    let responseSchema: any = null;

    if (module === 'reading') {
      prompt = `Generate a brand new authentic IELTS ${examType} Reading passage with 8 exam questions.
Topic suggestion: ${topicHint || 'Atmospheric science, architectural history, animal cognition, or sustainable materials'}.
Requirements:
1. Academic/formal scholarly tone (~650-750 words).
2. Divide into labelled paragraphs A, B, C, D, E.
3. 8 questions of diverse real IELTS formats: True/False/Not Given, Multiple Choice, and Sentence Completion.
4. For each question provide exact correct answer, detailed explanation, and paragraph reference.`;

      responseSchema = {
        type: Type.OBJECT,
        properties: {
          title: { type: Type.STRING },
          subtitle: { type: Type.STRING },
          paragraphs: {
            type: Type.ARRAY,
            items: {
              type: Type.OBJECT,
              properties: {
                label: { type: Type.STRING },
                content: { type: Type.STRING }
              },
              required: ['label', 'content']
            }
          },
          questions: {
            type: Type.ARRAY,
            items: {
              type: Type.OBJECT,
              properties: {
                id: { type: Type.INTEGER },
                type: { type: Type.STRING },
                instruction: { type: Type.STRING },
                prompt: { type: Type.STRING },
                options: {
                  type: Type.ARRAY,
                  items: {
                    type: Type.OBJECT,
                    properties: {
                      id: { type: Type.STRING },
                      text: { type: Type.STRING }
                    },
                    required: ['id', 'text']
                  }
                },
                correctAnswer: { type: Type.STRING },
                explanation: { type: Type.STRING },
                passageParagraphRef: { type: Type.STRING }
              },
              required: ['id', 'type', 'instruction', 'prompt', 'correctAnswer', 'explanation']
            }
          }
        },
        required: ['title', 'subtitle', 'paragraphs', 'questions']
      };
    } else if (module === 'listening') {
      prompt = `Generate an authentic IELTS Listening section with audio dialogue script and 6 questions.
Topic suggestion: ${topicHint || 'University campus services, city library tour, environmental research tutorial, or architectural lecture'}.
Requirements:
1. Context description and 2 speakers having natural British/International English conversation.
2. Full dialogue script with at least 8 dialogue turns containing key answers.
3. 6 IELTS questions with exact correct answers and explanations.`;

      responseSchema = {
        type: Type.OBJECT,
        properties: {
          title: { type: Type.STRING },
          context: { type: Type.STRING },
          speakers: { type: Type.ARRAY, items: { type: Type.STRING } },
          audioScript: {
            type: Type.ARRAY,
            items: {
              type: Type.OBJECT,
              properties: {
                speaker: { type: Type.STRING },
                text: { type: Type.STRING }
              },
              required: ['speaker', 'text']
            }
          },
          questions: {
            type: Type.ARRAY,
            items: {
              type: Type.OBJECT,
              properties: {
                id: { type: Type.INTEGER },
                type: { type: Type.STRING },
                instruction: { type: Type.STRING },
                prompt: { type: Type.STRING },
                options: {
                  type: Type.ARRAY,
                  items: {
                    type: Type.OBJECT,
                    properties: {
                      id: { type: Type.STRING },
                      text: { type: Type.STRING }
                    },
                    required: ['id', 'text']
                  }
                },
                correctAnswer: { type: Type.STRING },
                explanation: { type: Type.STRING }
              },
              required: ['id', 'type', 'instruction', 'prompt', 'correctAnswer', 'explanation']
            }
          }
        },
        required: ['title', 'context', 'speakers', 'audioScript', 'questions']
      };
    } else if (module === 'writing') {
      prompt = `Generate an authentic IELTS ${examType} Writing exam with Task 1 and Task 2.
Topic suggestion: ${topicHint || 'Urbanization, artificial intelligence, environmental conservation, or education'}.
Task 1: If Academic, provide bar chart data with 4 categories across two time periods. If General, provide a formal letter scenario.
Task 2: Discursive essay prompt with clear instructions and a complete Band 9 sample essay.`;

      responseSchema = {
        type: Type.OBJECT,
        properties: {
          title: { type: Type.STRING },
          examType: { type: Type.STRING },
          task1: {
            type: Type.OBJECT,
            properties: {
              type: { type: Type.STRING },
              chartType: { type: Type.STRING },
              chartTitle: { type: Type.STRING },
              chartData: {
                type: Type.ARRAY,
                items: {
                  type: Type.OBJECT,
                  properties: {
                    label: { type: Type.STRING },
                    valueA: { type: Type.NUMBER },
                    valueB: { type: Type.NUMBER },
                    unit: { type: Type.STRING }
                  },
                  required: ['label', 'valueA', 'valueB', 'unit']
                }
