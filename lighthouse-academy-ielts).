import { ExamType } from '../types/ielts'; export function calculateListeningBand(rawScore: number): number { if (rawScore >= 39) return 9.0; if (rawScore >= 37) return 8.5; if (rawScore >= 35) return 8.0; if (rawScore >= 32) return 7.5; if (rawScore >= 30) return 7.0; if (rawScore >= 26) return 6.5; if (rawScore >= 23) return 6.0; if (rawScore >= 18) return 5.5; if (rawScore >= 16) return 5.0; if (rawScore >= 13) return 4.5; if (rawScore >= 10) return 4.0; if (rawScore >= 6) return 3.5; if (rawScore >= 4) return 3.0; return 2.5; } export function calculateReadingBand(rawScore: number, type: ExamType = 'academic'): number { if (type === 'academic') { if (rawScore >= 39) return 9.0; if (rawScore >= 37) return 8.5; if (rawScore >= 35) return 8.0; if (rawScore >= 33) return 7.5; if (rawScore >= 30) return 7.0; if (rawScore >= 27) return 6.5; if (rawScore >= 23) return 6.0; if (rawScore >= 19) return 5.5; if (rawScore >= 15) return 5.0; if (rawScore >= 13) return 4.5; if (rawScore >= 10) return 4.0; if (rawScore >= 6) return 3.5; return 3.0; } else { if (rawScore >= 40) return 9.0; if (rawScore >= 39) return 8.5; if (rawScore >= 37) return 8.0; if (rawScore >= 36) return 7.5; if (rawScore >= 34) return 7.0; if (rawScore >= 32) return 6.5; if (rawScore >= 30) return 6.0; if (rawScore >= 27) return 5.5; if (rawScore >= 23) return 5.0; if (rawScore >= 19) return 4.5; if (rawScore >= 15) return 4.0; if (rawScore >= 8) return 3.5; return 3.0; } } export function calculateOverallBand( reading: number, listening: number, writing: number, speaking: number ): number { const avg = (reading + listening + writing + speaking) / 4; const floor = Math.floor(avg); const remainder = avg - floor; if (remainder < 0.25) return floor; if (remainder < 0.75) return floor + 0.5; return floor + 1.0; } export function getBandDescriptor(band: number): { level: string; summary: string } { if (band >= 9.0) return { level: 'Expert User (Band 9.0)', summary: 'Fully operational command.' }; if (band >= 8.0) return { level: 'Very Good User (Band 8.0 - 8.5)', summary: 'Handles complex detailed argumentation.' }; if (band >= 7.0) return { level: 'Good User (Band 7.0 - 7.5)', summary: 'Operational command with occasional inaccuracies.' }; if (band >= 6.0) return { level: 'Competent User (Band 6.0 - 6.5)', summary: 'Generally effective command.' }; if (band >= 5.0) return { level: 'Modest User (Band 5.0 - 5.5)', summary: 'Partial command.' }; return { level: 'Developing User (< Band 5.0)', summary: 'Basic competence.' }; }

