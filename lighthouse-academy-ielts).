  try {
    const { taskType, prompt, submission } = req.body;
    const wordCount = submission.trim().split(/\s+/).length;

    if (!apiKey) {
      const bandEstimate = wordCount < 140 ? 5.5 : wordCount < 220 ? 6.5 : 7.0;
      return res.json({
        overallBand: bandEstimate,
        criteria: {
          taskAchievement: { score: bandEstimate, feedback: 'Addressed main prompts with relevant ideas.' },
          coherenceCohesion: { score: bandEstimate, feedback: 'Logical flow with clear paragraphing and connectors.' },
          lexicalResource: { score: bandEstimate, feedback: 'Good range of academic vocabulary.' },
          grammaticalAccuracy: { score: bandEstimate, feedback: 'Variety of complex sentence structures.' }
        },
        wordCount,
        strengths: ['Clear organizational structure', 'Directly responds to the prompt'],
        areasForImprovement: ['Introduce more C1/C2 collocations', 'Deepen supporting examples'],
        vocabularyUpgrades: [
